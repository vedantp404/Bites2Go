{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_AI_BACKEND_URL": "https://bites2go-api.onrender.com"
      }
    },
    "production": {}
  },
  "submit": {
    "production": {}
  }
}
