# Public configuration only; these values are bundled, not secrets.
# Leave blank for offline mode. Configuration alone does NOT enable cloud in Stage 9.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local AI Backend URL (optional override)
# - For physical Android phone testing on same Wi-Fi/LAN: http://<LAN_IP>:8000 (e.g. http://192.168.1.100:8000)
# - For Android Emulator: http://10.0.2.2:8000 (default fallback on Android)
# - For iOS Simulator / Web: http://localhost:8000 (default fallback)
EXPO_PUBLIC_AI_BACKEND_URL=
