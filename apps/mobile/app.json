{
  "expo": {
    "name": "Bites2Go",
    "slug": "bites2go",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Bites2Go to access microphone for voice meal logging."
      }
    },
    "android": {
      "package": "com.bites2go",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "platforms": ["android"],
    "plugins": [
      "expo-status-bar",
      "expo-router",
      "expo-sqlite",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F0",
          "dark": {
            "backgroundColor": "#151C18"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Bites2Go to access your microphone for voice meal logging.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "scheme": "bites2go",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "projectId": "1e504316-51f2-4b43-ab54-ffcd26d92eba"
      }
    }
  }
}
