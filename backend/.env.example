# Bites2Go Dual-Provider AI Service Environment Configuration
# Copy this file to backend/.env and replace placeholders with your local keys.
# backend/.env is strictly ignored by Git and never committed.

# ---------------------------------------------------------------------------
# Provider Architecture Selection
# ---------------------------------------------------------------------------
# Primary provider: "gemini" or "openrouter" (default: gemini)
AI_PRIMARY_PROVIDER=gemini

# Enable automatic intelligent fallback if the primary provider encounters
# quota exhaustion, rate limits (HTTP 429), or transient outages (HTTP 503/504)
AI_FALLBACK_ENABLED=true

# ---------------------------------------------------------------------------
# Google Gemini (Primary Provider)
# ---------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (e.g. gemini-3.5-flash, gemini-3.8-flash, gemini-flash-latest)
GEMINI_MODEL=gemini-3.5-flash

# Per-attempt request timeout in seconds (default: 15.0)
GEMINI_TIMEOUT_SECONDS=15.0

# Automatic bounded retries for transient server errors (HTTP 503/504)
GEMINI_MAX_RETRIES=1

# ---------------------------------------------------------------------------
# OpenRouter (Fallback Provider)
# ---------------------------------------------------------------------------
# Obtain an API key from OpenRouter: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model identifier.
# "openrouter/free" is the official smart router that automatically routes to
# active free multimodal models with zero cost (e.g. Gemma 4, Nemotron Super VL).
# Alternatively specify a fixed model: google/gemma-4-31b-it:free or a paid model.
OPENROUTER_MODEL=openrouter/free

# OpenRouter base API URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter request timeout in seconds (default: 25.0)
OPENROUTER_TIMEOUT_SECONDS=25.0

# OpenRouter retries for transient HTTP 502/503/504 network errors
OPENROUTER_MAX_RETRIES=1

# ---------------------------------------------------------------------------
# Server Runtime Settings
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Max image upload size (default: 10 MB in bytes)
MAX_IMAGE_SIZE_BYTES=10485760

# CORS Allowed Origins (comma-separated, default: *)
ALLOWED_ORIGINS=*
