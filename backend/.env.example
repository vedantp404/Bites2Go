# Bites2Go AI Food Recognition Service Environment Configuration
# Copy this file to backend/.env and replace placeholders with your local values.
# backend/.env is strictly ignored by Git.

# Google AI Studio Gemini API Key (Secret - server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model selection (recommended: gemini-3.5-flash or gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash

# Server runtime settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Request limits
MAX_IMAGE_SIZE_BYTES=10485760
GEMINI_TIMEOUT_SECONDS=30.0

# CORS Allowed Origins (comma-separated, default is *)
ALLOWED_ORIGINS=*

