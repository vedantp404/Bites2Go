# Bites2Go Dual-Provider AI Service Environment Configuration
# Copy this file to backend/.env and replace placeholders with your local keys.
# backend/.env is strictly ignored by Git and never committed.

# ---------------------------------------------------------------------------
# Provider Architecture Selection (Task-Specific Routing)
# ---------------------------------------------------------------------------
# Legacy default fallback selection (used if task-specific overrides are unset)
AI_PRIMARY_PROVIDER=gemini

# Photo Food Recognition routing: Primary = Gemini Vision, Fallback = Vision-capable OpenRouter
PHOTO_PRIMARY_PROVIDER=gemini
PHOTO_FALLBACK_PROVIDER=openrouter

# Voice Meal Parsing routing: Primary = Nemotron 3 Ultra Free on OpenRouter, Fallback = Gemini Text
VOICE_PRIMARY_PROVIDER=openrouter
VOICE_FALLBACK_PROVIDER=gemini

# Enable automatic intelligent fallback if the primary provider encounters
# quota exhaustion, rate limits (HTTP 429), or transient outages (HTTP 503/504)
AI_FALLBACK_ENABLED=true

# ---------------------------------------------------------------------------
# Google Gemini (Photo Primary / Voice Fallback)
# ---------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (e.g. gemini-3.5-flash, gemini-flash-latest)
GEMINI_MODEL=gemini-3.5-flash

# Disable default thinking tokens for fast structured JSON (~2.7s-8.5s photo latency)
GEMINI_THINKING_BUDGET=0

# Max output tokens for Gemini structured responses
GEMINI_MAX_OUTPUT_TOKENS=1500

# Per-attempt request timeout in seconds (default: 14.0)
GEMINI_TIMEOUT_SECONDS=14.0

# Automatic bounded retries for transient server errors (HTTP 503/504) when fallback is disabled
GEMINI_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# OpenRouter (Voice Primary / Photo Vision Fallback)
# ---------------------------------------------------------------------------
# Obtain an API key from OpenRouter: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Voice Meal Parsing (Primary): Text-only model (image payloads are strictly blocked)
VOICE_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
VOICE_OPENROUTER_ALTERNATIVE_MODEL=
VOICE_PRIMARY_TIMEOUT_SECONDS=14.0
VOICE_OPENROUTER_MAX_TOKENS=900

# Photo Food Recognition (Fallback): Vision-capable + structured-JSON free model
# Bounded alternative vision model is tried at most once if sufficient budget remains
PHOTO_OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
PHOTO_OPENROUTER_ALTERNATIVE_MODEL=dots-studio/dots-3-note-preview:free

# Legacy fallback model aliases (ignored for photo if set to openrouter/free unless overridden)
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_ALTERNATIVE_MODEL=dots-studio/dots-3-note-preview:free

# OpenRouter base API URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter request timeout and max completion tokens
OPENROUTER_TIMEOUT_SECONDS=19.0
OPENROUTER_MAX_TOKENS=2000

# OpenRouter retries for transient HTTP 502/503/504 network errors (when fallback disabled)
OPENROUTER_MAX_RETRIES=1

# Bounded cooldowns after provider HTTP 429/402 (prevents hammering free-tier limits)
RATE_LIMIT_COOLDOWN_ENABLED=true
RATE_LIMIT_BURST_COOLDOWN_MIN_SECONDS=15.0
RATE_LIMIT_BURST_COOLDOWN_MAX_SECONDS=60.0
RATE_LIMIT_UPSTREAM_COOLDOWN_SECONDS=20.0
RATE_LIMIT_DAILY_COOLDOWN_MAX_SECONDS=300.0

# ---------------------------------------------------------------------------
# Server Runtime Settings, Image Optimization & Request Deadlines
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Image optimization before inference (preserves aspect ratio & strips EXIF)
MAX_IMAGE_DIMENSION=1024
IMAGE_JPEG_QUALITY=82

# Server deadline budgets (must complete before mobile 45s photo / 40s voice timeouts)
SERVER_DEADLINE_SECONDS=35.0
VOICE_SERVER_DEADLINE_SECONDS=32.0

# Optional git commit identifier (automatically set on Render via RENDER_GIT_COMMIT)
# GIT_COMMIT=dev

# Max image upload size (default: 10 MB in bytes)
MAX_IMAGE_SIZE_BYTES=10485760

# Audio-Native Voice Meal Parsing (Milestone 4F: Primary = Gemini Audio Understanding)
VOICE_AUDIO_PRIMARY_PROVIDER=gemini
VOICE_AUDIO_FALLBACK_PROVIDER=none
GEMINI_AUDIO_MODEL=gemini-3.5-flash
VOICE_AUDIO_TIMEOUT_SECONDS=18.0
VOICE_AUDIO_SERVER_DEADLINE_SECONDS=32.0
VOICE_AUDIO_MAX_OUTPUT_TOKENS=1800
VOICE_AUDIO_REPAIR_ENABLED=true
MAX_AUDIO_SIZE_BYTES=10485760

# CORS Allowed Origins (comma-separated, default: *)
ALLOWED_ORIGINS=*
